class Tray:
    SIZES = (
        ("Pequeño", 0.28, 0.50),
        ("Mediano", 0.34, 0.62),
        ("Grande", 0.42, 0.75),
        ("Máximo", 0.60, 0.88),
    )
    OPACITIES = (
        ("Opaco", 1.00),
        ("Suave", 0.90),
        ("Fuerte", 0.75),
    )
    # Súper+A NUNCA puede funcionar en GNOME (es suyo: rejilla de
    # aplicaciones); ofrecer solo combos que el shell no tenga cogidos.
    KEYS = (
        ("Súper + Intro", "<Super>Return"),
        ("Súper + T", "<Super>t"),
        ("Sin atajo", ""),
    )

    def __init__(self):
        write_icons()
        self.icon_normal = str(OC.ICON_DIR / "icon.svg")
        self.icon_alert = str(OC.ICON_DIR / "icon-alert.svg")
        self.icon_busy = [str(OC.ICON_DIR / f"icon-busy{i}.svg") for i in range(4)]
        self._frame = 0
        self._icon_state = None

        self.indicator = AyatanaAppIndicator3.Indicator.new(
            "oc-tray", self.icon_normal,
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title("OpenCode")

        self.sessions = []
        self.alerts = set()
        self.busy = set()
        self._sig = None
        self._help_win = None
        self._update_ver = None

        self.rebuild_menu()
        settings = OC.load_settings()
        apply_keybinding(settings.get("keybinding", "<Super>Return"))

        # Sincronizar autostart solo con preferencias explícitas del ajuste
        if "autostart" in settings and settings["autostart"] != OC.autostart_enabled():
            OC.set_autostart(bool(settings["autostart"]))

        GLib.timeout_add_seconds(2, self.on_poll)
        GLib.timeout_add(350, self.on_anim)
        self._update_avisado = 0.0
        GLib.timeout_add_seconds(20, self._check_update_once)
        GLib.timeout_add_seconds(15 * 60, self.check_update)

    # ---------- encuesta ----------
    def on_poll(self):
        settings = OC.load_settings()
        sessions = OC.managed_sessions()
        alerts = OC.alerts_present()
        busy = {s for s in sessions if OC.busy(s) is True}
        sig = json.dumps(settings, sort_keys=True)
        if sessions != self.sessions or alerts != self.alerts or sig != self._sig:
            self.rebuild_menu()
            self._sig = sig
        self.sessions, self.alerts, self.busy = sessions, alerts, busy
        return True

    def on_anim(self):
        if self.alerts:
            state = "alert"
        elif self.busy:
            state = f"busy{self._frame}"
            self._frame = (self._frame + 1) % 4
        else:
            state = "normal"
        if state != self._icon_state:
            self._icon_state = state
            if state == "alert":
                self.indicator.set_icon_full(self.icon_alert, "OpenCode: atención")
            elif state.startswith("busy"):
                self.indicator.set_icon_full(self.icon_busy[int(state[-1])], "OpenCode: trabajando")
            else:
                self.indicator.set_icon_full(self.icon_normal, "OpenCode")
        return True

    # ---------- actualizaciones ----------
    def _check_update_once(self):
        self.check_update()
        return False

    def check_update(self):
        """Consulta la última release en un hilo (sin bloquear la UI)."""
        if not OC.load_settings().get("update_check", True):
            return True

        def worker():
            ver = OC.latest_release_version()
            if ver and OC.version_newer(ver, OC.app_version()):
                GLib.idle_add(self._update_found, ver)

        threading.Thread(target=worker, daemon=True).start()
        return True

    def _update_found(self, ver):
        nueva = ver != self._update_ver
        if nueva:
            self._update_ver = ver
            self.rebuild_menu()
        # urgencia crítica: en GNOME queda en pantalla hasta cerrarla (un
        # aviso efímero se perdía si nadie miraba); y se repite cada 6 h
        # mientras la actualización siga pendiente
        if nueva or time.time() - self._update_avisado > 6 * 3600:
            self._update_avisado = time.time()
            subprocess.run(
                ["notify-send", "--urgency", "critical",
                 "--app-name", "ConBarAI",
                 f"ConBarAI v{ver} disponible",
                 "Actualiza desde el menú del icono (o con: conbarai --update)."],
                check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        return False

    def on_update(self, *_):
        subprocess.Popen(
            [BIN_APP, "--update"],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        # la actualización reinicia la app; retirar la entrada evita
        # lanzarla dos veces mientras tanto
        self._update_ver = None
        self.rebuild_menu()

    # ---------- menú ----------
    def rebuild_menu(self):
        settings = OC.load_settings()
        menu = Gtk.Menu()

        item_open = icon_item("Abrir / ocultar OpenCode", ["view-reveal-symbolic", "window-new-symbolic"])
        item_open.connect("activate", lambda *_: self.spawn_panel())
        menu.append(item_open)

        item_new = icon_item("Nueva sesión…", ["tab-new-symbolic", "list-add-symbolic"])
        item_new.connect("activate", self.on_pick_folder)
        menu.append(item_new)

        item_wd = icon_item("Carpeta de trabajo…", ["folder-open-symbolic", "folder-symbolic"])
        item_wd.set_tooltip_text(f"Actual: {OC.default_workdir(settings)}")
        item_wd.connect("activate", self.on_change_workdir)
        menu.append(item_wd)

        item_term = icon_item("Terminal del sistema", ["utilities-terminal-symbolic"])
        item_term.set_sensitive(resolve_terminal(settings) is not None)
        item_term.connect("activate", lambda *_: open_system_terminal())
        menu.append(item_term)

        item_close = icon_item("Cerrar paneles", ["process-stop-symbolic"])
        item_close.set_tooltip_text("Cierra los paneles; las sesiones tmux siguen vivas")
        item_close.connect("activate", self.on_close_panels)
        menu.append(item_close)

        sessions = OC.managed_sessions()
        if sessions:
            item_sess = icon_item("Sesiones", ["view-list-symbolic", "view-grid-symbolic"])
            sub = Gtk.Menu()
            workdirs = OC.session_workdirs()
            for s in sessions:
                wd = workdirs.get(s, "")
                label = f"{s} · {os.path.basename(wd)}" if wd else s
                icons = (
                    ["dialog-warning-symbolic"] if s in self.alerts
                    else ["utilities-terminal-symbolic"]
                )
                it = icon_item(label, icons)
                it.connect("activate", lambda _i, se=s, w=wd: self.spawn_panel(session=se, workdir=w))
                sub.append(it)
            item_sess.set_submenu(sub)
            menu.append(item_sess)

        recents = settings.get("recent_dirs") or []
        if recents:
            item_rec = icon_item("Carpetas recientes", ["document-open-recent-symbolic"])
            sub = Gtk.Menu()
            for wd in recents[:5]:
                it = icon_item(
                    os.path.basename(str(wd).rstrip("/")) or str(wd),
                    ["folder-symbolic", "text-x-generic-symbolic"],
                )
                it.set_tooltip_text(str(wd))
                it.connect("activate", lambda _i, w=wd: self.spawn_panel(workdir=w))
                sub.append(it)
            item_rec.set_submenu(sub)
            menu.append(item_rec)

        menu.append(self.build_size_menu(settings))
        menu.append(self.build_opacity_menu(settings))
        menu.append(self.build_theme_menu(settings))
        menu.append(self.build_key_menu(settings))
        menu.append(self.build_diag_menu(settings))

        menu.append(Gtk.SeparatorMenuItem())

        item_continue = check_item(
            "Abrir continuando la última sesión (-c)",
            bool(settings.get("continue_session", True)),
            lambda *_: self._toggle_setting("continue_session", True),
        )
        item_continue.set_tooltip_text(
            "OpenCode arranca con -c y retoma el contexto anterior; "
            "desmárcalo para empezar siempre de cero"
        )
        menu.append(item_continue)

        menu.append(check_item(
            "Ocultar al perder el foco",
            bool(settings.get("autohide", True)),
            lambda *_: self._toggle_setting("autohide", True),
        ))

        menu.append(check_item(
            "Arrancar al iniciar el sistema",
            OC.autostart_enabled(),
            self.on_autostart,
        ))

        menu.append(check_item(
            "Avisar de versiones nuevas",
            bool(settings.get("update_check", True)),
            lambda *_: self._toggle_setting("update_check", True),
        ))

        menu.append(Gtk.SeparatorMenuItem())

        item_help = icon_item("Ayuda", ["help-contents-symbolic", "help-browser-symbolic"])
        item_help.connect("activate", self.on_help)
        menu.append(item_help)

        if getattr(self, "_update_ver", None):
            item_up = icon_item(
                f"Actualizar a v{self._update_ver}",
                ["software-update-available-symbolic", "system-software-update"],
            )
            item_up.set_tooltip_text("Descarga la release nueva y reinicia la app")
            item_up.connect("activate", self.on_update)
            menu.append(item_up)

        ver = OC.app_version()
        item_ver = icon_item(
            f"ConBarAI {ver}" if ver else "ConBarAI",
            ["help-about-symbolic", "dialog-information-symbolic"],
        )
        item_ver.set_tooltip_text("Abrir el repositorio del proyecto")
        item_ver.connect("activate", lambda *_: open_repo())
        menu.append(item_ver)

        item_quit = icon_item("Salir", ["application-exit-symbolic"])
        item_quit.set_tooltip_text("Cierra la app completa: panel, sesiones y vigía")
        item_quit.connect("activate", self.on_quit)
        menu.append(item_quit)

        menu.show_all()
        self.indicator.set_menu(menu)

    def build_size_menu(self, settings):
        item_size = icon_item("Tamaño", ["zoom-fit-best-symbolic"])
        sub = Gtk.Menu()
        current = (float(settings.get("width", 0.34)), float(settings.get("height", 0.62)))
        for label, w, h in self.SIZES:
            active = abs(current[0] - w) < 0.01 and abs(current[1] - h) < 0.01
            sub.append(radio_item(label, active, lambda _i, w=w, h=h: self.on_size(w, h)))
        item_size.set_submenu(sub)
        return item_size

    def build_opacity_menu(self, settings):
        item_op = icon_item("Transparencia", ["weather-fog-symbolic"])
        sub = Gtk.Menu()
        current = float(settings.get("opacity", 0.97))
        for label, op in self.OPACITIES:
            active = abs(current - op) < 0.02
            sub.append(radio_item(label, active, lambda _i, op=op: self._update_setting("opacity", op)))
        item_op.set_submenu(sub)
        return item_op

    def build_theme_menu(self, settings):
        item_t = icon_item("Tema", ["applications-graphics-symbolic"])
        sub = Gtk.Menu()
        current = settings.get("theme", "tokyo-night")
        for key, label in THEME_LABELS.items():
            sub.append(radio_item(
                label, current == key,
                lambda _i, key=key: self._update_setting("theme", key),
            ))
        item_t.set_submenu(sub)
        return item_t

    def build_key_menu(self, settings):
        item_key = icon_item("Tecla de apertura", ["input-keyboard-symbolic"])
        sub = Gtk.Menu()
        current = settings.get("keybinding", "<Super>Return")
        for label, binding in self.KEYS:
            sub.append(radio_item(
                label, current == binding,
                lambda _i, b=binding: self.on_key(b),

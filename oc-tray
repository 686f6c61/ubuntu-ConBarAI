#!/usr/bin/env python3
"""oc-tray: icono de OpenCode en la barra superior de GNOME (ConBarAI).

Estado del icono (alerta / trabajando / normal), menú con sesiones,
carpetas recientes, tamaño, transparencia, tema, tecla de apertura y
terminal del sistema. Ajustes en ~/.config/oc-drop/settings.json.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import warnings
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

# GTK3/libayatana emiten DeprecationWarning sistemáticos: no aportan aquí.
warnings.filterwarnings("ignore", category=DeprecationWarning)

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3, GLib, Gtk  # noqa: E402

import oc_common as OC  # noqa: E402

BIN_DROP = str(Path.home() / ".local/bin/oc-drop")

SCHEMA_MEDIA = "org.gnome.settings-daemon.plugins.media-keys"
SCHEMA_CHILD = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
KEY_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/"

THEME_LABELS = {
    "tokyo-night": "Tokyo Night",
    "catppuccin": "Catppuccin",
    "dracula": "Dracula",
    "gruvbox": "Gruvbox",
}


def icon_item(label, icons):
    """Gtk.ImageMenuItem con el primer icono disponible del tema."""
    item = Gtk.ImageMenuItem(label=label)
    item.set_always_show_image(True)
    theme = Gtk.IconTheme.get_default()
    name = next((n for n in icons if theme.has_icon(n)), "application-x-executable-symbolic")
    item.set_image(Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU))
    return item


def gsettings_get(schema, key):
    out = subprocess.run(
        ["gsettings", "get", schema, key], capture_output=True, text=True
    )
    return out.stdout.strip()


def gsettings_set(schema, key, value):
    subprocess.run(
        ["gsettings", "set", schema, key, value],
        check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def apply_keybinding(binding):
    """Registra (o retira) el atajo global de ConBarAI en GNOME."""
    raw = gsettings_get(SCHEMA_MEDIA, "custom-keybindings") or "@as []"
    items = [
        i
        for i in re.findall(r"['\"]([^'\"]+)['\"]", raw)
        if re.match(r"^/org/gnome/settings-daemon/plugins/media-keys/", i)
    ]
    if binding:
        if KEY_PATH not in items:
            items.append(KEY_PATH)
        newlist = "[" + ", ".join(f"'{i}'" for i in items) + "]"
        gsettings_set(SCHEMA_MEDIA, "custom-keybindings", newlist)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "name", "OpenCode flotante")
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "command", BIN_DROP)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "binding", binding)
    elif KEY_PATH in items:
        items = [i for i in items if i != KEY_PATH]
        newlist = "[" + ", ".join(f"'{i}'" for i in items) + "]"
        gsettings_set(SCHEMA_MEDIA, "custom-keybindings", newlist)
        for key in ("name", "command", "binding"):
            gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", key, "")


TERMINAL_CANDIDATES = (
    "ghostty", "gnome-terminal", "konsole", "alacritty", "kitty",
    "xterm", "x-terminal-emulator",
)


def resolve_terminal(settings):
    name = settings.get("terminal", "auto") or "auto"
    if name != "auto":
        if shutil.which(name):
            return name
    for term in TERMINAL_CANDIDATES:
        if shutil.which(term):
            return term
    return None


def open_system_terminal():
    settings = OC.load_settings()
    term = resolve_terminal(settings)
    if not term:
        return
    wd = OC.default_workdir(settings)
    args = {
        "ghostty": ["ghostty", f"--working-directory={wd}"],
        "gnome-terminal": ["gnome-terminal", f"--working-directory={wd}"],
        "konsole": ["konsole", "--workdir", wd],
        "alacritty": ["alacritty", "--working-directory", wd],
        "kitty": ["kitty", "--directory", wd],
        "xterm": ["xterm"],
        "x-terminal-emulator": ["x-terminal-emulator"],
    }[term]
    inherit_cwd = term in ("xterm", "x-terminal-emulator")
    subprocess.Popen(
        args,
        cwd=wd if inherit_cwd else None,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def write_icons():
    """Iconos del tray: normal, alerta y 4 fotogramas de 'trabajando'."""
    OC.ICON_DIR.mkdir(parents=True, exist_ok=True)
    normal = OC.ICON_DIR / "icon.svg"
    if not normal.exists():
        normal.write_text(SVG_FORMAT.format(color="#f2f2f2", op=1.0))
    (OC.ICON_DIR / "icon-alert.svg").write_text(
        SVG_FORMAT.format(color="#e5c07b", op=1.0)
    )
    for i, op in enumerate((1.0, 0.55, 0.25, 0.08)):
        (OC.ICON_DIR / f"icon-busy{i}.svg").write_text(
            SVG_FORMAT.format(color="#f2f2f2", op=op)
        )


SVG_FORMAT = """<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
  <g fill="none" stroke="{color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5.5 6.5 L11 12 L5.5 17.5"/>
    <path d="M12.5 17.5 H19" stroke-opacity="{op}"/>
  </g>
</svg>
"""


class Tray:
    SIZES = (
        ("Pequeño", 0.28, 0.50),
        ("Mediano", 0.34, 0.62),
        ("Grande", 0.42, 0.75),
        ("Máximo", 0.60, 0.88),
    )
    OPACITIES = (
        ("Opaco", 1.00),
        ("Suave", 0.90),
        ("Fuerte", 0.75),
    )
    KEYS = (
        ("Super + Intro", "<Super>Return"),
        ("Super + A", "<Super>a"),
        ("Sin atajo", ""),
    )

    def __init__(self):
        write_icons()
        self.icon_normal = str(OC.ICON_DIR / "icon.svg")
        self.icon_alert = str(OC.ICON_DIR / "icon-alert.svg")
        self.icon_busy = [str(OC.ICON_DIR / f"icon-busy{i}.svg") for i in range(4)]
        self._frame = 0
        self._icon_state = None

        self.indicator = AyatanaAppIndicator3.Indicator.new(
            "oc-tray", self.icon_normal,
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title("OpenCode")

        self.sessions = []
        self.alerts = set()
        self.busy = set()
        self._sig = None

        self.rebuild_menu()
        settings = OC.load_settings()
        apply_keybinding(settings.get("keybinding", "<Super>Return"))

        # Sincronizar autostart solo con preferencias explícitas del ajuste
        if "autostart" in settings and settings["autostart"] != OC.autostart_enabled():
            OC.set_autostart(bool(settings["autostart"]))

        GLib.timeout_add_seconds(2, self.on_poll)
        GLib.timeout_add(350, self.on_anim)

    # ---------- encuesta ----------
    def on_poll(self):
        settings = OC.load_settings()
        sessions = OC.managed_sessions()
        alerts = OC.alerts_present()
        busy = {s for s in sessions if OC.busy(s) is True}
        sig = json.dumps(settings, sort_keys=True)
        if sessions != self.sessions or alerts != self.alerts or sig != self._sig:
            self.rebuild_menu()
            self._sig = sig
        self.sessions, self.alerts, self.busy = sessions, alerts, busy
        return True

    def on_anim(self):
        if self.alerts:
            state = "alert"
        elif self.busy:
            state = f"busy{self._frame}"
            self._frame = (self._frame + 1) % 4
        else:
            state = "normal"
        if state != self._icon_state:
            self._icon_state = state
            if state == "alert":
                self.indicator.set_icon_full(self.icon_alert, "OpenCode: atención")
            elif state.startswith("busy"):
                self.indicator.set_icon_full(self.icon_busy[int(state[-1])], "OpenCode: trabajando")
            else:
                self.indicator.set_icon_full(self.icon_normal, "OpenCode")
        return True

    # ---------- menú ----------
    def rebuild_menu(self):
        settings = OC.load_settings()
        menu = Gtk.Menu()

        item_open = icon_item("Abrir / ocultar OpenCode", ["view-reveal-symbolic", "window-new-symbolic"])
        item_open.connect("activate", lambda *_: self.spawn_panel())
        menu.append(item_open)

        item_new = icon_item("Nueva sesión…", ["tab-new-symbolic", "list-add-symbolic"])
        item_new.connect("activate", self.on_pick_folder)
        menu.append(item_new)

        item_term = icon_item("Terminal del sistema", ["utilities-terminal-symbolic"])
        item_term.set_sensitive(resolve_terminal(settings) is not None)
        item_term.connect("activate", lambda *_: open_system_terminal())
        menu.append(item_term)

        item_close = icon_item("Cerrar paneles", ["process-stop-symbolic"])
        item_close.set_tooltip_text("Cierra los paneles; las sesiones tmux siguen vivas")
        item_close.connect("activate", self.on_close_panels)
        menu.append(item_close)

        sessions = OC.managed_sessions()
        if sessions:
            item_sess = icon_item("Sesiones", ["view-list-symbolic", "view-grid-symbolic"])
            sub = Gtk.Menu()
            workdirs = OC.session_workdirs()
            for s in sessions:
                wd = workdirs.get(s, "")
                label = f"{s} · {os.path.basename(wd)}" if wd else s
                icons = (
                    ["dialog-warning-symbolic"] if s in self.alerts
                    else ["utilities-terminal-symbolic"]
                )
                it = icon_item(label, icons)
                it.connect("activate", lambda _i, se=s, w=wd: self.spawn_panel(session=se, workdir=w))
                sub.append(it)
            item_sess.set_submenu(sub)
            menu.append(item_sess)

        recents = settings.get("recent_dirs") or []
        if recents:
            item_rec = icon_item("Carpetas recientes", ["document-open-recent-symbolic"])
            sub = Gtk.Menu()
            for wd in recents[:5]:
                it = icon_item(
                    os.path.basename(str(wd).rstrip("/")) or str(wd),
                    ["folder-symbolic", "text-x-generic-symbolic"],
                )
                it.set_tooltip_text(str(wd))
                it.connect("activate", lambda _i, w=wd: self.spawn_panel(workdir=w))
                sub.append(it)
            item_rec.set_submenu(sub)
            menu.append(item_rec)

        menu.append(self.build_size_menu(settings))
        menu.append(self.build_opacity_menu(settings))
        menu.append(self.build_theme_menu(settings))
        menu.append(self.build_key_menu(settings))

        menu.append(Gtk.SeparatorMenuItem())

        self.item_autohide = Gtk.CheckMenuItem(label="Ocultar al perder el foco")
        self.item_autohide.set_active(bool(settings.get("autohide", True)))
        self.item_autohide.connect("toggled", self.on_autohide)
        menu.append(self.item_autohide)

        self.item_autostart = Gtk.CheckMenuItem(label="Arrancar al iniciar el sistema")
        self.item_autostart.set_active(OC.autostart_enabled())
        self.item_autostart.connect("toggled", self.on_autostart)
        menu.append(self.item_autostart)

        menu.append(Gtk.SeparatorMenuItem())

        item_quit = icon_item("Salir", ["application-exit-symbolic"])
        item_quit.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(item_quit)

        menu.show_all()
        self.indicator.set_menu(menu)

    def build_size_menu(self, settings):
        item_size = icon_item("Tamaño", ["zoom-fit-best-symbolic"])
        sub = Gtk.Menu()
        first = None
        current = (float(settings.get("width", 0.34)), float(settings.get("height", 0.62)))
        for label, w, h in self.SIZES:
            item = Gtk.RadioMenuItem.new_with_label_from_widget(first, label)
            if first is None:
                first = item
            if abs(current[0] - w) < 0.01 and abs(current[1] - h) < 0.01:
                item.set_active(True)
            item.connect("toggled", self.on_size, w, h)
            sub.append(item)
        item_size.set_submenu(sub)
        return item_size

    def build_opacity_menu(self, settings):
        item_op = icon_item("Transparencia", ["weather-fog-symbolic"])
        sub = Gtk.Menu()
        first = None
        current = float(settings.get("opacity", 0.97))
        for label, op in self.OPACITIES:
            item = Gtk.RadioMenuItem.new_with_label_from_widget(first, label)
            if first is None:
                first = item
            if abs(current - op) < 0.02:
                item.set_active(True)
            item.connect("toggled", self.on_opacity, op)
            sub.append(item)
        item_op.set_submenu(sub)
        return item_op

    def build_theme_menu(self, settings):
        item_t = icon_item("Tema", ["applications-graphics-symbolic"])
        sub = Gtk.Menu()
        first = None
        current = settings.get("theme", "tokyo-night")
        for key, label in THEME_LABELS.items():
            item = Gtk.RadioMenuItem.new_with_label_from_widget(first, label)
            if first is None:
                first = item
            if current == key:
                item.set_active(True)
            item.connect("toggled", self.on_theme, key)
            sub.append(item)
        item_t.set_submenu(sub)
        return item_t

    def build_key_menu(self, settings):
        item_key = icon_item("Tecla de apertura", ["input-keyboard-symbolic"])
        sub = Gtk.Menu()
        first = None
        current = settings.get("keybinding", "<Super>Return")
        for label, binding in self.KEYS:
            item = Gtk.RadioMenuItem.new_with_label_from_widget(first, label)
            if first is None:
                first = item
            if current == binding:
                item.set_active(True)
            item.connect("toggled", self.on_key, binding)
            sub.append(item)
        item_key.set_submenu(sub)
        return item_key

    # ---------- acciones ----------
    def _update_setting(self, key, value):
        data = OC.load_settings()
        data[key] = value
        OC.save_settings(data)

    def on_pick_folder(self, *_):
        dlg = Gtk.FileChooserDialog(
            title="Carpeta de trabajo de la sesión",
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Abrir", Gtk.ResponseType.OK)
        default = str(OC.DEFAULT_WORKDIR)
        if os.path.isdir(default):
            dlg.set_current_folder(default)
        path = None
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
        dlg.destroy()
        if path:
            self.spawn_panel(workdir=path)

    def spawn_panel(self, session=None, workdir=None):
        args = [BIN_DROP]
        if session:
            args += ["--session", session]
        elif workdir:
            args += ["--session", OC.session_for_workdir(workdir)]
        if workdir:
            args += ["--workdir", workdir]
        subprocess.Popen(
            args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        if workdir:
            data = OC.load_settings()
            rec = [d for d in (data.get("recent_dirs") or []) if d != workdir]
            rec.insert(0, workdir)
            data["recent_dirs"] = rec[:5]
            OC.save_settings(data)

    def on_close_panels(self, *_):
        subprocess.Popen(
            [BIN_DROP, "--quit"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def on_autohide(self, item):
        self._update_setting("autohide", item.get_active())

    def on_autostart(self, item):
        enabled = OC.set_autostart(item.get_active())
        self._update_setting("autostart", enabled)
        if item.get_active() != enabled:
            item.set_active(enabled)

    def on_size(self, item, width, height):
        if not item.get_active():
            return
        self._update_setting("width", width)
        self._update_setting("height", height)

    def on_opacity(self, item, opacity):
        if not item.get_active():
            return
        self._update_setting("opacity", opacity)

    def on_theme(self, item, key):
        if not item.get_active():
            return
        self._update_setting("theme", key)

    def on_key(self, item, binding):
        if not item.get_active():
            return
        self._update_setting("keybinding", binding)
        apply_keybinding(binding)


def main():
    GLib.set_prgname("oc-tray")
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()

class HelpWindow(Gtk.Window):
    """Ayuda con estética de consola: página de manual monoespaciada con
    los colores y la tipografía del tema activo del panel."""

    def __init__(self):
        super().__init__(title=HELP_TITLE)
        self.set_default_size(760, 800)
        self.set_position(Gtk.WindowPosition.CENTER)
        s = OC.load_settings()
        theme = OC.THEMES.get(s["theme"], OC.THEMES["tokyo-night"])
        fam = OC.detect_font(s)
        css = Gtk.CssProvider()
        css.load_from_data(f"""
        .ayuda-fondo {{ background-color: {theme["bg"]}; }}
        .ayuda-cabecera {{
          background-color: {theme["bg_head"]};
          border-bottom: 1px solid {theme["border"]};
        }}
        .ayuda-texto, .ayuda-cabecera label {{
          color: {theme["fg"]};
          font-family: "{fam}", monospace;
          font-size: 13px;
        }}
        .ayuda-texto selection {{
          background-color: {theme["accent"]};
          color: {theme["bg"]};
        }}
        """.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        self.get_style_context().add_class("ayuda-fondo")

        raiz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        cabecera = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        cabecera.get_style_context().add_class("ayuda-cabecera")
        punto = Gtk.Label()
        punto.set_markup(f'<span foreground="{theme["green"]}">●</span>')
        titulo = Gtk.Label(label="conbarai(1) · manual de ConBarAI",
                           xalign=0.0)
        for w, izq in ((punto, 14), (titulo, 8)):
            w.set_margin_top(9)
            w.set_margin_bottom(9)
            w.set_margin_start(izq)
            cabecera.pack_start(w, False, False, 0)
        raiz.pack_start(cabecera, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.get_style_context().add_class("ayuda-fondo")
        label = Gtk.Label()
        label.set_markup(help_markup(theme))
        label.set_line_wrap(True)
        label.set_xalign(0.0)
        label.set_yalign(0.0)
        label.set_selectable(True)
        for setter in (
            label.set_margin_top, label.set_margin_bottom,
            label.set_margin_start, label.set_margin_end,
        ):
            setter(22)
        label.get_style_context().add_class("ayuda-texto")
        scroll.add(label)
        viewport = label.get_parent()
        if viewport is not None:
            viewport.get_style_context().add_class("ayuda-fondo")
        raiz.pack_start(scroll, True, True, 0)
        self.add(raiz)
        self._scroll = scroll
        # la etiqueta seleccionable roba el foco y arrastra el scroll al
        # final: la ayuda siempre abre por arriba
        self.connect("map", lambda *_: GLib.idle_add(self._scroll_top))
        self.connect("key-press-event", self._on_key)

    def _scroll_top(self):
        adj = self._scroll.get_vadjustment()
        adj.set_value(adj.get_lower())
        return False

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False


def write_icons():
    """Iconos del tray: normal, alerta y 4 fotogramas de 'trabajando'."""
    OC.ICON_DIR.mkdir(parents=True, exist_ok=True)
    normal = OC.ICON_DIR / "icon.svg"
    if not normal.exists():
        normal.write_text(SVG_FORMAT.format(color="#f2f2f2", op=1.0))
    (OC.ICON_DIR / "icon-alert.svg").write_text(
        SVG_FORMAT.format(color="#e5c07b", op=1.0)
    )
    for i, op in enumerate((1.0, 0.55, 0.25, 0.08)):
        (OC.ICON_DIR / f"icon-busy{i}.svg").write_text(
            SVG_FORMAT.format(color="#f2f2f2", op=op)
        )



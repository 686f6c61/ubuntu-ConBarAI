def icon_item(label, icons):
    """Gtk.ImageMenuItem con el primer icono disponible del tema."""
    item = Gtk.ImageMenuItem(label=label)
    item.set_always_show_image(True)
    theme = Gtk.IconTheme.get_default()
    name = next((n for n in icons if theme.has_icon(n)), "application-x-executable-symbolic")
    item.set_image(Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU))
    return item


def check_item(label, active, callback):
    """Opción activable con icono de casilla (los CheckMenuItem de GTK no
    admiten imagen; el icono refleja el estado y el menú se reconstruye al
    cambiar el ajuste)."""
    icons = (
        ["checkbox-checked-symbolic", "object-select-symbolic"]
        if active else ["checkbox-symbolic", "window-close-symbolic"]
    )
    item = icon_item(label, icons)
    item.connect("activate", callback)
    return item


def radio_item(label, active, callback):
    """Opción excluyente con icono de radio (mismo criterio que check_item)."""
    icons = (
        ["radio-checked-symbolic", "object-select-symbolic"]
        if active else ["radio-symbolic", "radio-mixed-symbolic"]
    )
    item = icon_item(label, icons)
    item.connect("activate", callback)
    return item


def gsettings_get(schema, key):
    out = subprocess.run(
        ["gsettings", "get", schema, key], capture_output=True, text=True
    )
    return out.stdout.strip()


def gsettings_set(schema, key, value):
    subprocess.run(
        ["gsettings", "set", schema, key, value],
        check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def apply_keybinding(binding):
    """Registra (o retira) el atajo global de ConBarAI en GNOME."""
    raw = gsettings_get(SCHEMA_MEDIA, "custom-keybindings") or "@as []"
    items = [
        i
        for i in re.findall(r"['\"]([^'\"]+)['\"]", raw)
        if re.match(r"^/org/gnome/settings-daemon/plugins/media-keys/", i)
    ]
    if binding:
        for ruta in (KEY_PATH, KEY_PATH_HIDE):
            if ruta not in items:
                items.append(ruta)
        newlist = "[" + ", ".join(f"'{i}'" for i in items) + "]"
        gsettings_set(SCHEMA_MEDIA, "custom-keybindings", newlist)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "name", "OpenCode flotante")
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "command", BIN_APP)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH}", "binding", binding)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH_HIDE}", "name", "ConBarAI ocultar")
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH_HIDE}", "command", f"{BIN_DROP} --hide")
        # <Super>q lo tiene el dock de Ubuntu (dash-to-dock) y el grab
        # falla en silencio; <Super>x está libre y es mnemónico (la X)
        gsettings_set(f"{SCHEMA_CHILD}:{KEY_PATH_HIDE}", "binding", "<Super>x")
    elif KEY_PATH in items or KEY_PATH_HIDE in items:
        items = [i for i in items if i not in (KEY_PATH, KEY_PATH_HIDE)]
        newlist = "[" + ", ".join(f"'{i}'" for i in items) + "]"
        gsettings_set(SCHEMA_MEDIA, "custom-keybindings", newlist)
        for ruta in (KEY_PATH, KEY_PATH_HIDE):
            for key in ("name", "command", "binding"):
                gsettings_set(f"{SCHEMA_CHILD}:{ruta}", key, "")


TERMINAL_CANDIDATES = (
    "ghostty", "gnome-terminal", "konsole", "alacritty", "kitty",
    "xterm", "x-terminal-emulator",
)


def resolve_terminal(settings):
    name = settings.get("terminal", "auto") or "auto"
    if name != "auto":
        if shutil.which(name):
            return name
    for term in TERMINAL_CANDIDATES:
        if shutil.which(term):
            return term
    return None


def open_system_terminal():
    settings = OC.load_settings()
    term = resolve_terminal(settings)
    if not term:
        return
    wd = OC.default_workdir(settings)
    args = {
        "ghostty": ["ghostty", f"--working-directory={wd}"],
        "gnome-terminal": ["gnome-terminal", f"--working-directory={wd}"],
        "konsole": ["konsole", "--workdir", wd],
        "alacritty": ["alacritty", "--working-directory", wd],
        "kitty": ["kitty", "--directory", wd],
        "xterm": ["xterm"],
        "x-terminal-emulator": ["x-terminal-emulator"],
    }.get(term, [term])
    inherit_cwd = term in ("xterm", "x-terminal-emulator") or term not in (
        "ghostty", "gnome-terminal", "konsole", "alacritty", "kitty")
    subprocess.Popen(
        args,
        cwd=wd if inherit_cwd else None,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )



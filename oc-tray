    # ---------- acciones ----------
    def _update_setting(self, key, value):
        data = OC.load_settings()
        data[key] = value
        OC.save_settings(data)

    def _toggle_setting(self, key, default):
        data = OC.load_settings()
        data[key] = not bool(data.get(key, default))
        OC.save_settings(data)
        self.rebuild_menu()

    def on_pick_folder(self, *_):
        dlg = Gtk.FileChooserDialog(
            title="Carpeta de trabajo de la sesión",
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Abrir", Gtk.ResponseType.OK)
        default = OC.default_workdir()
        if os.path.isdir(default):
            dlg.set_current_folder(default)
        path = None
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
        dlg.destroy()
        if path:
            self.spawn_panel(workdir=path)

    def on_change_workdir(self, *_):
        dlg = Gtk.FileChooserDialog(
            title="Carpeta de trabajo por defecto",
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons(
            "Cancelar", Gtk.ResponseType.CANCEL,
            "Usar esta carpeta", Gtk.ResponseType.OK,
        )
        current = OC.default_workdir()
        if os.path.isdir(current):
            dlg.set_current_folder(current)
        path = None
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
        dlg.destroy()
        if not path or path == current:
            return
        confirm = Gtk.MessageDialog(
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Cambiar la carpeta de trabajo",
        )
        confirm.format_secondary_text(
            f"El panel se reiniciará y OpenCode trabajará desde:\n{path}\n\n"
            "La sesión del panel por defecto se cierra y se reabre ahí "
            "(con \"continuar sesión\" activo, OpenCode retoma la "
            "conversación anterior)."
        )
        ok = confirm.run() == Gtk.ResponseType.YES
        confirm.destroy()
        if not ok:
            return
        self._update_setting("workdir", path)
        self.restart_default_panel()

    def restart_default_panel(self):
        """Cierra los paneles, termina la sesión tmux por defecto y reabre
        el panel: OpenCode arranca ya en la carpeta de trabajo nueva."""
        subprocess.Popen(
            [BIN_DROP, "--quit"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

        def relaunch():
            subprocess.run(
                ["tmux", "kill-session", "-t", OC.DEFAULT_SESSION],
                check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            self.spawn_panel()
            return False

        GLib.timeout_add(800, relaunch)

    def spawn_panel(self, session=None, workdir=None):
        args = [BIN_DROP]
        if session:
            args += ["--session", session]
        elif workdir:
            args += ["--session", OC.session_for_workdir(workdir)]
        if workdir:
            args += ["--workdir", workdir]
        subprocess.Popen(
            args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        if workdir:
            data = OC.load_settings()
            rec = [d for d in (data.get("recent_dirs") or []) if d != workdir]
            rec.insert(0, workdir)
            data["recent_dirs"] = rec[:5]
            OC.save_settings(data)

    def on_close_panels(self, *_):
        subprocess.Popen(
            [BIN_DROP, "--quit"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def on_help(self, *_):
        if self._help_win is not None:
            try:
                if self._help_win.get_window() is not None:
                    self._help_win.present()
                    return
            except Exception:  # noqa: BLE001
                pass
        self._help_win = HelpWindow()
        self._help_win.connect("destroy", self._help_closed)
        self._help_win.show_all()
        self._help_win.present()

    def _help_closed(self, *_):
        self._help_win = None

    def on_quit(self, *_):
        """Salir de verdad: panel, sesiones de OpenCode, vigía e icono.
        Con continue_session activo, OpenCode retoma la conversación al
        volver a abrir la app (-c)."""
        confirm = Gtk.MessageDialog(
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Salir de ConBarAI",
        )
        confirm.format_secondary_text(
            "Se cierran el panel, las sesiones de OpenCode y el vigía de "
            "crashes. Con \"Abrir continuando la última sesión (-c)\" "
            "activo, OpenCode retomará la conversación al volver a abrir."
        )
        ok = confirm.run() == Gtk.ResponseType.YES
        confirm.destroy()
        if not ok:
            return
        subprocess.run(
            [BIN_DROP, "--quit"], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        for s in OC.managed_sessions():
            subprocess.run(
                ["tmux", "kill-session", "-t", s], check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        subprocess.run(
            ["systemctl", "--user", "stop", "oc-crash-watch.service"],
            check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        Gtk.main_quit()

    def on_autostart(self, *_):
        enabled = OC.set_autostart(not OC.autostart_enabled())
        self._update_setting("autostart", enabled)
        self.rebuild_menu()

    def on_size(self, width, height):
        self._update_setting("width", width)
        self._update_setting("height", height)

    def on_key(self, binding):
        self._update_setting("keybinding", binding)
        apply_keybinding(binding)


def main():
    GLib.set_prgname("oc-tray")
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()

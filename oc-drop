    # ---------- portapapeles y arrastrar/soltar ----------

    def _setup_clipboard_dnd(self):
        Vte.Terminal.drag_dest_set(
            self.term, Gtk.DestDefaults.MOTION | Gtk.DestDefaults.HIGHLIGHT,
            [
                Gtk.TargetEntry.new("text/uri-list", 0, 1),
                Gtk.TargetEntry.new("text/plain", 0, 2),
                Gtk.TargetEntry.new("UTF8_STRING", 0, 2),
                Gtk.TargetEntry.new("STRING", 0, 2),
            ],
            Gdk.DragAction.COPY,
        )
        self.term.connect("drag-data-received", self.on_drag_data)

    def on_drag_data(self, _term, _ctx, _x, _y, data, info, _time):
        if info == 1:
            uris = [u.strip() for u in (data.get_text() or "").splitlines() if u.strip()]
            paths = [GLib.filename_from_uri(u)[0] for u in uris if u.startswith("file:")]
            paths = [p for p in paths if p]
            if paths:
                self.term.paste_text(" ".join(shlex.quote(p) for p in paths))
                return
        texto = data.get_text()
        if texto:
            self.term.paste_text(texto)

    def do_copy(self):
        if self.term.get_has_selection():
            self.term.copy_clipboard_format(Vte.Format.TEXT)

    def do_paste(self):
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        try:
            text = cb.wait_for_text()
        except Exception:  # noqa: BLE001
            text = None
        if text:
            self.term.paste_text(text)
        else:
            self.term.paste_clipboard()

    def on_term_key(self, _term, event):
        if event.type != Gdk.EventType.KEY_PRESS:
            return False
        kv = event.keyval
        if kv in (Gdk.KEY_x, Gdk.KEY_X) and (
            event.state & Gdk.ModifierType.SUPER_MASK
        ):
            self.hide()
            return True
        ctrl = Gdk.ModifierType.CONTROL_MASK
        shift = Gdk.ModifierType.SHIFT_MASK
        mods = event.state & (ctrl | shift)
        if kv in (Gdk.KEY_C, Gdk.KEY_c):
            if mods == (ctrl | shift):
                self.do_copy()
                return True
            if mods == ctrl and self.term.get_has_selection():
                self.do_copy()
                return True
            return False
        if kv in (Gdk.KEY_V, Gdk.KEY_v) and mods in (ctrl, ctrl | shift):
            self.do_paste()
            return True
        if kv == Gdk.KEY_Insert and mods in (shift, ctrl):
            if mods == shift:
                self.do_paste()
            else:
                self.do_copy()
            return True
        return False

    def _build_ctx_menu(self):
        menu = Gtk.Menu()
        mi_copy = Gtk.MenuItem.new_with_label("Copiar")
        mi_copy.connect("activate", lambda *_: self.do_copy())
        mi_paste = Gtk.MenuItem.new_with_label("Pegar")
        mi_paste.connect("activate", lambda *_: self.do_paste())
        for mi in (mi_copy, mi_paste):
            menu.append(mi)
        menu.show_all()
        return menu

    def on_term_button(self, term, event):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        if not hasattr(self, "_ctx_menu") or self._ctx_menu is None:
            self._ctx_menu = self._build_ctx_menu()
        menu = self._ctx_menu
        menu.set_screen(term.get_screen())
        menu.popup_at_pointer(event)
        return True

    # ---------- consola de diagnóstico (segunda terminal) ----------

    def check_new_report(self):
        """Si el vigía dejó una petición de análisis y el panel está a la vista,
        abre la consola de diagnóstico (ventana aparte) con el agente en
        directo, sin tocar el tamaño del panel."""
        if not self.get_visible():
            return False
        ev, ts = OC.take_crash_pending(self._pending_ts)
        if ev is None:
            return False
        self._pending_ts = ts
        prog = ev.get("program") or "desconocido"
        safe = re.sub(r"[^A-Za-z0-9._-]", "_", prog)[:40]
        report = OC.CRASH_DIR / (
            time.strftime("%Y%m%d-%H%M%S") + f"-{safe}-report.md"
        )
        self.open_diag(OC.crash_prompt(ev), prog, report)
        OC.clear_crash_pending()
        return True

    def open_diag(self, prompt, prog=None, report_path=None):
        """Abre la consola de diagnóstico como ventana aparte (estilo Omarchy):
        el panel principal no cambia ni un píxel."""
        w = self.diag_win
        if w is not None:
            try:
                if w.get_window() is not None:
                    return  # ya hay un diagnóstico en marcha
            except Exception:  # noqa: BLE001
                pass
            self.diag_win = None
        self.diag_win = DiagWindow(self, prompt, prog, report_path)

    def diag_closed(self):
        self.diag_win = None
        self.term.grab_focus()

    def follow_diag(self):
        """Si el usuario redimensiona el panel con la consola abierta,
        la consola se recoloca para seguir gemela y pegada. También se
        autocorrige si ella misma quedó fuera de su objetivo (un resize
        a medias, un empujón del WM)."""
        d = self.diag_win
        if d is None or d.closing:
            return
        gxp = d._x_geometry(self)
        gxd = d._x_geometry(d)
        if gxp is None or gxd is None:
            return
        f = self.get_scale_factor() or 1
        geo = (gxp["x"] // f, gxp["y"] // f, gxp["w"] // f, gxp["h"] // f)
        desincron = (
            abs(gxd["w"] - d._target_w * f) > 4 * f
            or abs(gxd["h"] - d._target_h * f) > 4 * f
            or abs(gxd["x"] - d._target_x_px) > 4 * f
            or abs(gxd["y"] - d._target_y_px) > 4 * f
        )
        if geo != getattr(d, "_panel_geo", None) or desincron:
            d._stable = d._tries = d._noeffect = 0
            d._xoff = d._yoff = 0
            d._last_actual = None
            d._place()
            GLib.timeout_add(250, d._assert_place)

    # ---------- redimensionado por los bordes (bandas de sombra) ----------

    def _edge_at(self, wx, wy):
        """Borde de redimensionado bajo el punto (coords lógicas de la
        ventana): banda de sombra izquierda, inferior o su esquina. Los
        lados superior y derecho son pantalla (panel anclado). Se mide
        con las constantes de sombra: la asignación del hijo empieza en
        0 aunque el dibujo vaya con el margen CSS."""
        w, h = self.get_size()
        izq = wx < SHADOW_L
        abajo = wy > h - SHADOW_B
        if izq and abajo:
            return Gdk.WindowEdge.SOUTH_WEST
        if izq:
            return Gdk.WindowEdge.WEST
        if abajo:
            return Gdk.WindowEdge.SOUTH
        return None

    def _set_edge_cursor(self, edge):
        if edge == self._cursor_edge:
            return
        self._cursor_edge = edge
        nombres = {
            Gdk.WindowEdge.WEST: "w-resize",
            Gdk.WindowEdge.SOUTH: "s-resize",
            Gdk.WindowEdge.SOUTH_WEST: "sw-resize",
        }
        gd = self.get_window()
        if gd is None:
            return
        if edge is None:
            gd.set_cursor(None)
        else:
            gd.set_cursor(Gdk.Cursor.new_from_name(
                self.get_display(), nombres[edge]))

    def on_window_motion(self, _w, event):
        self._set_edge_cursor(self._edge_at(event.x, event.y))
        return False

    def on_window_button(self, _w, event):
        edge = self._edge_at(event.x, event.y)
        if edge is not None and event.button == 1:
            self.begin_resize_drag(
                edge, event.button,
                int(event.x_root), int(event.y_root), event.time,
            )
            return True
        return False

    def on_configure(self, _w, _event):
        """Tras un redimensionado del usuario, guarda el tamaño como
        fracción de pantalla (con retardo, para no escribir por píxel)."""
        if self._maximized or not self.get_visible():
            return False
        if self._user_geo_timer:
            GLib.source_remove(self._user_geo_timer)
        self._user_geo_timer = GLib.timeout_add(600, self._save_user_geo)
        return False

    def _save_user_geo(self):
        self._user_geo_timer = 0
        if self._maximized or not self.get_visible():
            return False
        wa_x, wa_y, wa_w, wa_h = workarea()
        f = self.get_scale_factor() or 1
        w, h = self.get_size()
        wf = round((w - (SHADOW_L + SHADOW_R)) * f / wa_w, 4)
        hf = round((h - (SHADOW_T + SHADOW_B)) * f / wa_h, 4)
        s = OC.load_settings()
        if abs(s["width"] - wf) < 0.004 and abs(s["height"] - hf) < 0.004:
            return False
        s["width"], s["height"] = wf, hf
        self._geo_key = (wf, hf)
        OC.save_settings(s)
        return False

    # ---------- aspecto ----------

    def _apply_look(self, force=False):
        s = OC.load_settings()
        theme = OC.THEMES.get(s["theme"], OC.THEMES["tokyo-night"])
        key = (s["theme"], s["opacity"], s["font"], s["font_size"])
        if not force and key == self._look_key:
            return
        self._look_key = key
        screen = Gdk.Screen.get_default()
        if self._css_provider is not None:
            Gtk.StyleContext.remove_provider_for_screen(screen, self._css_provider)
        provider = Gtk.CssProvider()
        provider.load_from_data(build_css(theme, s["opacity"]).encode())
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self._css_provider = provider
        fam = OC.detect_font(s)
        self.term.set_font(Pango.FontDescription(f"{fam} {s['font_size']}"))
        # mismo criterio que en DiagWindow: el fondo del terminal lleva la
        # opacidad de la tarjeta (VTE no funde con lo pintado debajo)
        self.term.set_colors(
            rgba(theme["fg"]),
            rgba(theme["bg"], s["opacity"]),
            [rgba(c) for c in theme["palette"]],
        )
        if self.diag_win is not None:
            try:
                self.diag_win._style()
            except Exception:  # noqa: BLE001
                pass

    # ---------- sesión ----------

    def spawn(self):
        OC.record_session(self.session, self.workdir)
        OC.ensure_hooks(self.session)
        OC.ensure_project_skill(self.workdir)
        env = os.environ.copy()
        env.setdefault("TERM", "xterm-256color")
        env_list = [f"{k}={v}" for k, v in env.items()]
        argv = ["tmux", "new", "-A", "-s", self.session, "opencode"]
        # -c continúa la última sesión de opencode (p. ej. tras un reinicio
        # del equipo); el botón "Nueva sesión" fuerza un arranque limpio
        if (OC.load_settings().get("continue_session", True)
                and not self._fresh_next):
            argv.append("-c")
        self._fresh_next = False
        try:
            self.term.spawn_async(
                Vte.PtyFlags.DEFAULT, self.workdir, argv, env_list,
                GLib.SpawnFlags.DEFAULT, None, -1, None, None,
            )
        except TypeError:
            self.term.spawn_async(
                Vte.PtyFlags.DEFAULT, self.workdir, argv, env_list,
                GLib.SpawnFlags.DEFAULT, None, None, -1, None, None,
            )
        self.child_alive = True
        self._set_dot()
        GLib.timeout_add(400, self.tune_tmux)

    def tune_tmux(self):
        for opt, val in (("status", "off"), ("mouse", "on")):
            run_tmux(["set-option", "-t", self.session, opt, val])
        return False

    def on_new_session(self, *_):
        self._fresh_next = True  # sesión nueva = sin contexto arrastrado
        run_tmux(["kill-session", "-t", self.session])
        if self.child_alive:
            self._respawn_requested = True
        else:
            self.term.reset(True, True)
            self.spawn()
            self.show_drop()

    def on_child_exited(self, *_):
        self.child_alive = False
        self._set_dot()
        if self._respawn_requested:
            self._respawn_requested = False
            self.term.reset(True, True)
            self.spawn()
        elif self.get_visible():
            self.hide()

    def _set_dot(self, alert=False):
        """Prioridad: muerto (rojo) > alerta (ámbar) > vivo (verde)."""
        ctx = self.dot.get_style_context()
        ctx.remove_class("dead")
        ctx.remove_class("alert")
        if not self.child_alive:
            ctx.add_class("dead")
        elif alert:
            ctx.add_class("alert")

    # ---------- estado (encuesta del app) ----------

    def update_state(self):
        alert = self.session in OC.alerts_present()
        if not self.child_alive:
            self._set_dot(alert)
            self.spinner.stop()
            return
        state = OC.busy(self.session)
        if state is not None:
            self._busy = state
        if self._busy:
            self.spinner.start()
        else:
            self.spinner.stop()
        self._set_dot(alert)

    def update_usage(self):
        u = OC.usage(self.workdir)
        self.usage.set_text(OC.format_usage(*u) if u else "")

    def refresh_settings(self):
        """Aplica en vivo los cambios del menú del icono (tema, opacidad,
        tipografía y tamaño) sin tener que reabrir el panel."""
        if not self.get_visible():
            return
        self._apply_look()
        if self._maximized:
            return
        s = OC.load_settings()
        geo = (s["width"], s["height"])
        if self._geo_key is not None and geo != self._geo_key:
            self.apply_geometry()

    # ---------- mostrar / ocultar ----------

    def show_drop(self):
        self._apply_look()
        if not self.child_alive:
            self.term.reset(True, True)
            self.spawn()
        self.show_all()
        self.set_keep_above(True)
        GLib.idle_add(self.apply_geometry)
        self._grace_until = time.monotonic() + FOCUS_GRACE_S
        self.present()

    def toggle(self):
        if self.get_visible():
            self.hide()
        else:
            self.show_drop()

    def on_maximize(self, *_):
        self._maximized = not self._maximized
        self.btn_max_img.set_from_icon_name(
            "view-restore-symbolic" if self._maximized else "view-fullscreen-symbolic",
            Gtk.IconSize.MENU,
        )
        GLib.idle_add(self.apply_geometry)

    def apply_geometry(self):
        wa_x, wa_y, wa_w, wa_h = workarea()
        f = self.get_scale_factor() or 1
        if self._maximized:
            wf, hf = MAX_W, MAX_H
        else:
            s = OC.load_settings()
            wf, hf = s["width"], s["height"]
            self._geo_key = (wf, hf)
        card_w = int(wa_w * wf / f)
        card_h = int(wa_h * hf / f)
        self.resize(card_w + SHADOW_L + SHADOW_R, card_h + SHADOW_T + SHADOW_B)
        total_w = (card_w + SHADOW_L + SHADOW_R) * f
        x = (wa_x + wa_w - MARGIN_R * f - total_w + SHADOW_R * f) // f
        y = (wa_y + (MARGIN_T - SHADOW_T) * f) // f
        self.move(x, y)
        self.term.grab_focus()
        GLib.idle_add(self.apply_input_region)
        return False

    def apply_input_region(self):
        """La zona de sombra deja pasar los clics a las ventanas de abajo.
        OJO: input_shape_combine_region espera coordenadas LÓGICAS (GDK
        escala por su cuenta); multiplicar por el factor HiDPI desplazaba
        la región y dejaba muerta la franja de la cabecera (la X no
        respondía al ratón en pantallas 2x)."""
        try:
            card = self.get_child()
            alloc = card.get_allocation()
            region = cairo.Region(cairo.RectangleInt(
                alloc.x, alloc.y, alloc.width, alloc.height
            ))
            # bandas izquierda e inferior: asas de redimensionado (las
            # bandas superior y derecha siguen dejando pasar los clics)
            region.union(cairo.RectangleInt(
                0, alloc.y, alloc.x, alloc.height + SHADOW_B))
            region.union(cairo.RectangleInt(
                0, alloc.y + alloc.height, alloc.x + alloc.width, SHADOW_B))
            gd = self.get_window()
            if gd and alloc.width > 1:
                gd.input_shape_combine_region(region, 0, 0)
        except (OSError, ValueError) as e:
            OC.log("región de entrada no aplicada:", e)
        return False

    # ---------- eventos ----------

    def on_map_event(self, *_):
        GLib.idle_add(self.apply_geometry)

    def on_focus_in(self, *_):
        OC.clear_alert(self.session)
        self.update_state()
        return False

    def _active_window_xid(self):
        try:
            out = subprocess.check_output(
                ["xprop", "-root", "_NET_ACTIVE_WINDOW"],
                stderr=subprocess.DEVNULL,
                text=True,
            )
            m = re.search(r"window id # (0x[0-9a-fA-F]+)", out)
            return int(m.group(1), 16) if m else 0
        except (OSError, subprocess.SubprocessError):
            return -1

    def on_focus_out(self, *_):
        if not self.get_visible():
            return False
        # Los popups (menú contextual de VTE) roban el foco en XWayland sin
        # grab de GTK y sin ser la ventana activa: no cuentan como pérdida.
        active = self._active_window_xid()
        mine = self.get_window().get_xid() if self.get_window() else 0
        # la consola de diagnóstico es "nuestra": abrirla o usarla no debe
        # esconder el panel
        diag_xid = 0
        if self.diag_win is not None:
            try:
                gd = self.diag_win.get_window()
                diag_xid = gd.get_xid() if gd else 0
            except Exception:  # noqa: BLE001
                diag_xid = 0
        if (
            active > 0
            and active != mine
            and active != diag_xid
            and OC.load_settings().get("autohide", True)
            and time.monotonic() > self._grace_until
        ):
            self.hide()
        return False

    def on_delete(self, *_):
        self.hide()
        return True


class DropApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.windows = {}
        self._usage_tick = 0

    def do_startup(self):
        Gtk.Application.do_startup(self)
        GLib.timeout_add_seconds(2, self.on_poll)

    def do_command_line(self, command_line):
        args = list(command_line.get_arguments())[1:]
        session = workdir = None
        quit_all = False
        hide_all = False
        i = 0
        while i < len(args):
            if args[i] == "--session" and i + 1 < len(args):
                session = args[i + 1]
                i += 2
            elif args[i] == "--workdir" and i + 1 < len(args):
                workdir = args[i + 1]
                i += 2
            elif args[i] == "--quit":
                quit_all = True
                i += 1
            elif args[i] == "--hide":
                hide_all = True
                i += 1
            else:
                i += 1
        if hide_all:
            for win in list(self.windows.values()):
                if win.diag_win is not None:
                    win.diag_win.finish()
                win.hide()
            return 0
        if quit_all:
            for win in list(self.windows.values()):
                win.destroy()
            self.windows.clear()
            self.quit()
            return 0
        if session is None and workdir is not None:
            session = OC.session_for_workdir(workdir)
        session = session or OC.DEFAULT_SESSION
        try:
            OC.validate_session(session)
        except ValueError as e:
            OC.log("sesión rechazada:", e)
            return 1
        self.ensure_window(session, workdir)
        return 0

    def do_activate(self):
        self.ensure_window(OC.DEFAULT_SESSION, None)

    def ensure_window(self, session, workdir):
        win = self.windows.get(session)
        if win is not None:
            win.toggle()
            return
        s = OC.load_settings()
        wd = os.path.expanduser(workdir or OC.default_workdir(s))
        if not os.path.isdir(wd):
            wd = str(OC.HOME)
        win = DropWindow(self, session, wd)
        self.windows[session] = win
        win.show_drop()

    def on_poll(self):
        self._usage_tick += 1
        refresh_usage = self._usage_tick % 8 == 0
        for win in list(self.windows.values()):
            win.update_state()
            win.refresh_settings()
            win.follow_diag()
            if refresh_usage:
                win.update_usage()
            win.check_new_report()
        return True


def main():
    app = DropApp()
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()

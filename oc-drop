def workarea():
    """Área útil en coords X11 (excluye la barra superior de GNOME)."""
    try:
        out = subprocess.check_output(
            ["xprop", "-root", "_NET_WORKAREA"],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        m = re.search(r"=\s*(-?\d+),\s*(-?\d+),\s*(\d+),\s*(\d+)", out)
        if m:
            x, y, w, h = map(int, m.groups())
            return x, y, w, h
    except (OSError, subprocess.SubprocessError) as e:
        OC.log("xprop no disponible:", e)
    try:
        out = subprocess.check_output(
            ["xdotool", "getdisplaygeometry"],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        w, h = map(int, out.split())
        return 0, 64, w, h - 64
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        OC.log("xdotool no disponible:", e)
    return 0, 64, 1920, 1000


def run_tmux(args):
    try:
        return subprocess.run(
            ["tmux", *args],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as e:
        OC.log("tmux no disponible:", e)
        return None


class DiagWindow(Gtk.Window):
    """Ventana aparte con el agente diagnosticando un crash en directo.

    Nunca toca el tamaño del panel principal: como el agente de Omarchy,
    trabaja en su propia ventana (debajo del panel) y se cierra solo al
    terminar, dejando el informe guardado."""

    def __init__(self, parent, prompt, prog=None, report_path=None):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.parent_win = parent
        self.prog = prog or "desconocido"
        self.report_path = report_path
        self.closing = False
        self.set_title("ConBarAI · Diagnóstico de crash")
        self.set_decorated(False)
        self.set_resizable(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.connect("delete-event", lambda *a: (self.finish(), True)[1])

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class("drop-card")
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        head.get_style_context().add_class("drop-head")
        lbl = Gtk.Label(label="  Diagnóstico de crash", halign=Gtk.Align.START)
        lbl.get_style_context().add_class("drop-title")
        head.pack_start(lbl, True, True, 0)
        btn = Gtk.Button()
        btn.add(
            Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.MENU)
        )
        btn.get_style_context().add_class("hdr-btn")
        btn.set_tooltip_text("Cerrar diagnóstico")
        btn.connect("clicked", lambda *a: self.finish())
        head.pack_end(btn, False, False, 0)
        card.pack_start(head, False, False, 0)
        self.term = Vte.Terminal()
        self.term.set_scrollback_lines(5000)
        self.term.connect("child-exited", lambda *a: self.finish())
        self.term.connect("key-press-event", self.on_key)
        card.pack_start(self.term, True, True, 0)
        self.add(card)
        self.child_pid = -1
        self._target = None
        self._target_x_px = 0
        self._target_y_px = 0
        self._stable = 0
        self._tries = 0
        # margen que aplica el WM al move() en X (aprendido sobre la marcha)
        self._xoff = 0
        self._yoff = 0
        self._last_actual = None
        self._noeffect = 0
        self._style()
        self.show_all()
        self._place()
        # mutter re-coloca ventanas nuevas: se reafirma move() hasta que la
        # ventana quede pegada al borde inferior del panel.
        GLib.timeout_add(250, self._assert_place)
        self._spawn(prompt)
        self.term.grab_focus()

    def on_key(self, _term, event):
        if event.type != Gdk.EventType.KEY_PRESS:
            return False
        if event.keyval in (Gdk.KEY_x, Gdk.KEY_X) and (
            event.state & Gdk.ModifierType.SUPER_MASK
        ):
            self.finish()
            return True
        return False

    def _style(self):
        s = OC.load_settings()
        theme = OC.THEMES.get(s["theme"], OC.THEMES["tokyo-night"])
        fam = OC.detect_font(s)
        self.term.set_font(Pango.FontDescription(f"{fam} {s['font_size']}"))
        # VTE REEMPLAZA (no funde) lo que la tarjeta pinta debajo: un fondo
        # con alfa 0 deja un agujero transparente y el texto queda flotando.
        # El fondo del terminal lleva la misma opacidad que la tarjeta.
        self.term.set_colors(
            rgba(theme["fg"]),
            rgba(theme["bg"], s["opacity"]),
            [rgba(c) for c in theme["palette"]],
        )

    def _x_geometry(self, win):
        """Geometría de una ventana en coords X reales (la verdad del WM;
        GTK reporta posiciones con un pequeño desfase)."""
        try:
            xid = win.get_window().get_xid()
            out = subprocess.check_output(
                ["xwininfo", "-id", str(xid)],
                text=True, stderr=subprocess.DEVNULL,
            )
            vals = {}
            for key, pat in (
                ("x", r"Absolute upper-left X:\s*(-?\d+)"),
                ("y", r"Absolute upper-left Y:\s*(-?\d+)"),
                ("w", r"Width:\s*(\d+)"),
                ("h", r"Height:\s*(\d+)"),
            ):
                m = re.search(pat, out)
                if not m:
                    return None
                vals[key] = int(m.group(1))
            return vals
        except (OSError, subprocess.SubprocessError, AttributeError):
            return None

    def _place(self):
        """Colocación configurable (ajuste "diag_pos"): al lado del panel
        (su izquierda, mismo ancho y alto, borde con borde) o debajo. El
        panel principal no cambia ni un píxel."""
        gx = self._x_geometry(self.parent_win)
        wa_x, wa_y, _, wa_h = workarea()
        f = self.parent_win.get_scale_factor() or 1
        if gx:
            px, py = gx["x"] // f, gx["y"] // f
            pw, ph = gx["w"] // f, gx["h"] // f
        else:
            px, py = self.parent_win.get_position()
            pw, ph = self.parent_win.get_size()
        self._panel_geo = (px, py, pw, ph)
        card_w = pw - (SHADOW_L + SHADOW_R)
        below = OC.load_settings().get("diag_pos", "side") == "below"
        gap = 8  # separación fina entre tarjetas, igual en ambos modos
        if not below:
            # gemela del panel y pegada a su izquierda; recortada al
            # espacio libre y, si no cabe un mínimo legible, cae a debajo
            disponible = px - gap - (wa_x // f)
            if disponible < 300:
                below = True
            else:
                card_w = min(card_w, disponible)
        if below:
            # margen inferior para no pisar el borde del menú inferior
            bottom = (wa_y + wa_h) // f - 40
            ty = py + ph - SHADOW_B - SHADOW_T + gap
            card_h = max(200, min(460, bottom - ty - (SHADOW_T + SHADOW_B)))
            self._target_x_px = px * f
            self._target_y_px = ty * f
        else:
            card_h = ph - (SHADOW_T + SHADOW_B)
            # borde de la consola pegado al borde del panel (hueco de 8 px
            # entre tarjetas, sombras aparte)
            self._target_x_px = (px + SHADOW_L - gap - card_w - SHADOW_L) * f
            self._target_y_px = py * f
        w = card_w + SHADOW_L + SHADOW_R
        h = card_h + SHADOW_T + SHADOW_B
        self._target = (max(wa_x, self._target_x_px) // f,
                        self._target_y_px // f)
        self._target_w, self._target_h = w, h
        self.set_default_size(w, h)
        self.resize(w, h)
        self.move((self._target_x_px + self._xoff) // f,
                  (self._target_y_px + self._yoff) // f)

    def _assert_place(self):
        """Reafirma posición Y TAMAÑO contra la geometría X real hasta que
        mute 3 ticks seguidos (mutter re-coloca ventanas nuevas y GTK puede
        dejar la altura en la natural del contenido). El margen que aplica
        el WM al move() se aprende y se compensa solo."""
        if self.closing or self._target is None:
            return False
        f = self.get_scale_factor() or 1
        gx = self._x_geometry(self)
        if gx is None:
            if self.get_position() == self._target:
                self._stable += 1
                return self._stable < 3
            self._stable = 0
            self._tries += 1
            self.move(*self._target)
            return self._tries < 20
        dx = self._target_x_px - gx["x"]
        dy = self._target_y_px - gx["y"]
        ok_size = (abs(gx["w"] - self._target_w * f) <= 2
                   and abs(gx["h"] - self._target_h * f) <= 2)
        if abs(dx) <= 2 and abs(dy) <= 2 and ok_size:
            self._stable += 1
            return self._stable < 3
        actual = (gx["x"], gx["y"], gx["w"], gx["h"])
        if actual == self._last_actual:
            self._noeffect += 1
            if self._noeffect >= 4:
                return False  # el WM lo bloquea: se queda como está
        else:
            self._noeffect = 0
        self._last_actual = actual
        self._xoff += dx
        self._yoff += dy
        self._stable = 0
        self._tries += 1
        if not ok_size:
            self.resize(self._target_w, self._target_h)
        self.move((self._target_x_px + self._xoff) // f,
                  (self._target_y_px + self._yoff) // f)
        return self._tries < 20

    def _spawn(self, prompt):
        env = os.environ.copy()
        env.setdefault("TERM", "xterm-256color")
        env["OC_DIAG_PROMPT"] = prompt
        cfg = OC.crash_config()
        if cfg:
            env["OPENCODE_CONFIG"] = cfg
        # VTE no resuelve PATH para binarios fuera de /usr/bin: ruta absoluta.
        opencode = shutil.which("opencode") or "opencode"
        if self.report_path:
            env["OC_DIAG_REPORT"] = str(self.report_path)
            # `opencode run` (no interactivo) + tee: el informe queda en disco
            # y el análisis se ve en directo en la ventana.
            cmd = (
                f'{shlex.quote(opencode)} run "$OC_DIAG_PROMPT" 2>&1 '
                f'| tee "$OC_DIAG_REPORT"'
            )
        else:
            cmd = f'{shlex.quote(opencode)} run "$OC_DIAG_PROMPT"'
        argv = ["/bin/bash", "-c", cmd]
        env_list = [f"{k}={v}" for k, v in env.items()]
        try:
            self.term.spawn_async(
                Vte.PtyFlags.DEFAULT, self.parent_win.workdir, argv, env_list,
                GLib.SpawnFlags.DEFAULT, None, None, -1, None,
                self._spawn_cb, None,
            )
        except TypeError:
            try:
                self.term.spawn_async(
                    Vte.PtyFlags.DEFAULT, self.parent_win.workdir, argv, env_list,
                    GLib.SpawnFlags.DEFAULT, None, -1, None, None,
                )
                self.child_pid = 0
            except (GLib.Error, OSError) as e:
                OC.log("diag: fallo al lanzar el agente:", e)
                self._spawn_fail()

    def _spawn_cb(self, _term, pid, error, _data):
        if error is not None:
            OC.log("diag: el agente no arrancó:", error)
            self._spawn_fail()
        else:
            self.child_pid = pid or 0

    def _spawn_fail(self):
        try:
            self.term.feed(
                b"\r\n[ConBarAI] No se pudo lanzar el agente (opencode).\r\n"
            )
        except Exception:  # noqa: BLE001
            pass
        GLib.timeout_add_seconds(5, self.finish)

    def finish(self):
        """Cierra la ventana. El informe llegó por tee al stdout del agente
        (`opencode run`): aquí se limpia de ANSI y se le añade cabecera."""
        if self.closing:
            return
        self.closing = True
        try:
            if self.child_pid > 0:
                os.kill(self.child_pid, signal.SIGTERM)
        except OSError:
            pass
        if self.report_path is not None:
            try:
                raw = self.report_path.read_text(errors="replace")
                clean = re.sub(
                    r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)",
                    "", raw,
                ).strip()
                if clean:
                    ts = time.strftime("%Y-%m-%d %H:%M")
                    self.report_path.write_text(
                        f"# Informe de crash · {self.prog}\n\n"
                        f"- Generado: {ts} (agente en directo)\n\n---\n\n"
                        f"{clean}\n"
                    )
                else:
                    self.report_path.unlink()
            except OSError as e:
                OC.log("diag: informe no procesable:", e)
        self.parent_win.diag_closed()
        self.destroy()



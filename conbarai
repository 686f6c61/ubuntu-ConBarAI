#!/usr/bin/env bash
# ConBarAI - lanzador de la app completa.
# Arranca el icono de la barra y el vigía si no están, y abre/oculta el
# panel. Es lo que ejecuta la entrada del menú de Aplicaciones; también
# sirve desde terminal: `conbarai [--workdir RUTA | --quit]`.
set -u

BIN="$HOME/.local/bin"

# --update: descarga la AppImage de la última release, actualiza la
# instalación y reinicia la app entera con el código nuevo.
if [ "${1:-}" = "--update" ]; then
  DESTINO="$HOME/Aplicaciones"
  mkdir -p "$DESTINO"
  TMP="$(mktemp "$DESTINO/.conbarai-XXXXXX.AppImage")"
  URL="https://github.com/686f6c61/ubuntu-ConBarAI/releases/latest/download/ConBarAI-x86_64.AppImage"
  if ! curl -fsSL -o "$TMP" "$URL"; then
    rm -f "$TMP"
    notify-send "ConBarAI" "No se pudo descargar la actualización." 2>/dev/null
    exit 1
  fi
  chmod +x "$TMP"
  mv "$TMP" "$DESTINO/ConBarAI-x86_64.AppImage"
  if ! CONBARAI_INSTALL_ONLY=1 "$DESTINO/ConBarAI-x86_64.AppImage"; then
    notify-send "ConBarAI" "La actualización no terminó bien; ejecuta la AppImage a mano." 2>/dev/null
    exit 1
  fi
  systemctl --user try-restart oc-crash-watch.service 2>/dev/null || true
  "$BIN/oc-drop" --quit 2>/dev/null || true
  pkill -f "$BIN/oc-tray" 2>/dev/null || true
  sleep 1
  VER="$(grep -m1 '^version' "$HOME/.local/share/conbarai/app/pyproject.toml" 2>/dev/null | cut -d'"' -f2)"
  notify-send "ConBarAI" "Actualizado a la versión ${VER:-nueva}." 2>/dev/null
  exec "$BIN/conbarai"
fi

# Icono de la barra (si no está ya)
if ! pgrep -f "$BIN/oc-tray" >/dev/null 2>&1; then
  setsid "$BIN/oc-tray" >/dev/null 2>&1 &
fi

# Vigía de crashes, solo si el ajuste lo pide
if command -v systemctl >/dev/null 2>&1; then
  if python3 -c "import json,sys; sys.exit(0 if json.load(open('$HOME/.config/oc-drop/settings.json')).get('crash_watch', True) else 1)" 2>/dev/null; then
    systemctl --user start oc-crash-watch.service 2>/dev/null || true
  fi
fi

# Panel (abre u oculta; --quit cierra todos los paneles)
exec "$BIN/oc-drop" "$@"

[Unit]
Description=ConBarAI: vigila crashes del sistema y avisa
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/oc-crash-watch
Restart=always
RestartSec=10
# El binario decide en cada pasada si `crash_watch` está activo.

[Install]
WantedBy=graphical-session.target
